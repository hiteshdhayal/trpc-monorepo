# ──────────────────────────────────────────────────────────────────────────────
# FinalForms — Environment Variables Template
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env files with real values to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection URL
DATABASE_URL=postgresql://user:password@host:5432/dbname
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev_test

# ── Authentication ────────────────────────────────────────────────────────────
# JWT signing secret — use a strong random value in production (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_64_char_hex_string

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Next.js Frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Get a free API key at https://resend.com
# If absent, emails are logged to console (safe for development)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Set Authorized redirect URI to: https://<your-railway-domain>/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ──────────────────────────────────────────────────────────────────────────────
# SECRET ROTATION CHECKLIST
# Run through this list when deploying to production or after a suspected leak:
#
# [ ] DATABASE_URL        — Rotate PostgreSQL password in Railway/Supabase
# [ ] JWT_SECRET          — Generate new 64-char hex value; all sessions invalidated
# [ ] RESEND_API_KEY      — Revoke and regenerate in Resend dashboard
# [ ] GOOGLE_CLIENT_SECRET — Rotate in Google Cloud Console
# [ ] Railway env vars    — Update all variables in Railway project settings
# [ ] Vercel env vars     — Update all variables in Vercel project settings
# ──────────────────────────────────────────────────────────────────────────────
